{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "titwenty-beats",
  "main": "./index.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "BEATS",
      "bucket_name": "titwenty-beats"
    }
  ]
}
